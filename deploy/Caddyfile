{$DOMAIN} {
	encode zstd gzip
	@private path /metrics /docs /redoc /openapi.json
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
	}

	handle @private {
		respond 404
	}

	handle / {
		root * /srv/teramont
		rewrite * /index.html
		header Cache-Control "no-cache"
		file_server
	}

	handle_path /static/* {
		root * /srv/teramont
		header Cache-Control "no-cache"
		@immutable path_regexp immutable ^/assets/lumen/sprites-garden-[0-9a-f]{64}\.pack$
		header @immutable {
			Cache-Control "public, max-age=31536000, immutable"
			match status 200 206 304
		}
		file_server
	}

	handle {
		reverse_proxy api:8001
	}
}
