# Telegram bot
TG_BOT_TOKEN=
APP_URL=https://games.example.com

# Game profile database (inside the API container)
GAME_DB_PATH=runtime/teramont-games.sqlite3

# Production platform (leave DATABASE_URL and REDIS_URL empty for local SQLite)
DATABASE_URL=
REDIS_URL=
DATABASE_POOL_SIZE=0
# With deploy/compose.production.yml set DOMAIN, a strong password, and the URL:
# DATABASE_URL=postgresql://teramont:URL_ENCODED_PASSWORD@db:5432/teramont
DOMAIN=
POSTGRES_PASSWORD=

# Optional deployment helper credentials in deploy/.env
RAZVIVAYKA_SSH_HOST=
RAZVIVAYKA_SSH_USER=root
RAZVIVAYKA_SSH_PASSWORD=
RAZVIVAYKA_SSH_KEY_PATH=
